rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'dierbekrustamov040@gmail.com'
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Branches: Publicly readable, admin managed
    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories: Publicly readable, admin managed
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Products: Publicly readable, admin managed
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users: Owner or admin access
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Saved customer delivery addresses
      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admins list
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin invitations by phone
    match /adminInvitations/{invitationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit logs for admin actions
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders: Anyone or customer can place, owner and admin can read.
    // Customers can cancel their own orders if status is pending or confirmed.
    match /orders/{orderId} {
      allow create: if request.resource.data.total is number &&
                       request.resource.data.customerName is string &&
                       request.resource.data.customerPhone is string;
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.customerId == request.auth.uid &&
        (resource.data.status == 'pending' || resource.data.status == 'confirmed') &&
        request.resource.data.status == 'cancelled'
      );
      allow delete: if isAdmin();
    }
  }
}
