{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with phone authentication and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "phoneNumber", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin identity whitelist for authorized administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "role"]
    },
    "AdminEmail": {
      "title": "AdminEmail",
      "description": "Designated administrator email whitelist",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "addedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "AdminInvitation": {
      "title": "AdminInvitation",
      "description": "Pending administrator invitation or allowlist by phone number",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "status": { "type": "string", "enum": ["pending", "claimed"] },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["phoneNumber", "role", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail records for role management and administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string", "maxLength": 100 },
        "performedBy": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["action", "performedBy", "createdAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "FoodHub physical restaurant branch location worldwide",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "phone": { "type": "string", "maxLength": 30 },
        "openingHours": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "city", "address", "latitude", "longitude", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Food menu category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Food menu item or product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "calories": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "categoryId", "price", "isAvailable"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food delivery order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "serviceFee": { "type": "number" },
        "total": { "type": "number" },
        "payMethod": { "type": "string", "enum": ["cash", "click", "payme", "uzum"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "pending_payment", "paid", "refunded"] },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "ready_for_delivery", "out_for_delivery", "delivered", "cancelled"]
        },
        "cancellationReason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "total", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Online payment record and gateway transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "provider": { "type": "string", "enum": ["click", "payme", "uzum", "cash"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled", "refunded"] },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "amount", "provider", "status"]
    },
    "Address": {
      "title": "Address",
      "description": "Customer saved delivery address",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "apartment": { "type": "string" },
        "entrance": { "type": "string" },
        "floor": { "type": "string" },
        "notes": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["address", "latitude", "longitude"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection, read/write restricted to owner or admin"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/Address" },
      "description": "Saved customer delivery addresses"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Designated administrator credentials list"
    },
    "/adminEmails/{emailDoc}": {
      "schema": { "$ref": "#/entities/AdminEmail" },
      "description": "Administrator email whitelist"
    },
    "/adminInvitations/{invitationId}": {
      "schema": { "$ref": "#/entities/AdminInvitation" },
      "description": "Pending admin phone invitations"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Administrative actions audit log"
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Global FoodHub branches, publicly readable, writable by admin"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable menu categories, writable by admin only"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable menu items, writable by admin only"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer delivery orders. Readable by owner and admin, created by customers, updated by admin or owner for cancellation"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payment records. Readable by owner and admin"
    }
  }
}
